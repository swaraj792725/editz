{
  "manifestVersion": 5,
  "id": "app.editz.bridge.uxp",
  "name": "Editz",
  "version": "0.0.1",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "editzPanel",
      "label": { "default": "Editz" },
      "minimumSize": { "width": 200, "height": 120 },
      "preferredDockedSize": { "width": 320, "height": 220 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": ["ws://127.0.0.1:47800", "ws://localhost:47800"] },
    "localFileSystem": "fullAccess"
  }
}
